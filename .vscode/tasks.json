{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configurar",
            "type": "shell",
            "command": "cmake -S . -B build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: compilar",
            "type": "shell",
            "command": "cmake --build build -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compilar e executar",
            "type": "shell",
            "command": "./build/vampire_survivors",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: compilar",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}